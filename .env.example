APP_NAME="NUTRILINK"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Guatemala
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_GT

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# Dominios de correo permitidos para el auto-registro de empleados
# (lista separada por comas; vacío = registro deshabilitado)
REGISTRO_DOMINIOS=refugios.ve

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Base de datos: Neon (Postgres serverless) ─────────────────────────────
# Producción usa Neon. Para DESARROLLO LOCAL sin Postgres, usa SQLite:
#   DB_CONNECTION=sqlite
#   DB_DATABASE=database/database.sqlite
# Cadena de conexión de Neon: postgresql://usuario:contraseña@host/hospital_triage?sslmode=require
DB_CONNECTION=pgsql
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@ep-xxxx.region.aws.neon.tech/hospital_triage?sslmode=require
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hospital_triage
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="sistema@hospital.gt"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────────
# VARIABLES PARA PRODUCCIÓN EN VERCEL
# ─────────────────────────────────────────────────────────────────────────────
# En Vercel NO existe fichero .env: la configuración llega como variables de
# entorno inyectadas en el contenedor. Se declaran en
#   Settings > Environment Variables
# o con el CLI:
#   vercel env add NOMBRE
#
# Valores a declarar en Vercel (Producción):
#
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_KEY=base64:...            <- php artisan key:generate --show
#   APP_URL=https://tu-dominio.vercel.app
#   APP_TIMEZONE=America/Caracas
#
#   LOG_CHANNEL=stderr            <- Vercel captura stdout/stderr (no hay disco)
#   LOG_LEVEL=error
#
#   DB_CONNECTION=pgsql
#   DB_HOST=ep-snowy-lab-b47a57pb.c-6.us-east-2.aws.neon.tech
#   DB_PORT=5432
#   DB_DATABASE=neondb
#   DB_USERNAME=neondb_owner
#   DB_PASSWORD=...
#   DB_SSLMODE=require
#   DB_PERSISTENT=true
#   DB_QUERY_LOG=false            <- true solo para diagnóstico
#
#   SESSION_DRIVER=database       <- el filesystem es efímero entre instancias
#   CACHE_STORE=database
#   QUEUE_CONNECTION=sync         <- la app no despacha trabajos de cola
#   APP_MAINTENANCE_DRIVER=database
#
# IMPORTANTE:
#   - No uses el host con "-pooler" de Neon: rompe las transacciones
#     multi-sentencia (SQLSTATE 25P02).
#   - Las migraciones se ejecutan A PARTE, nunca al arrancar el contenedor:
#       php artisan migrate --force
#   - `docker-start.sh` (Render) hace migrate:fresh --seed y BORRARÍA los
#     datos: por eso aborta si detecta la variable VERCEL=1.
# ─────────────────────────────────────────────────────────────────────────────

