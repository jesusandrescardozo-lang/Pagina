# ── Vercel (Container runtime) — Laravel 9 + FrankenPHP ─────────────────────
# Guía oficial: https://vercel.com/kb/guide/laravel-php-with-docker
#
# IMPORTANTE: este fichero NO reemplaza al `Dockerfile` de Render.
#   - Vercel  usa Dockerfile.vercel  (entrypoint declarado en vercel.json)
#   - Render  sigue usando Dockerfile + docker-start.sh
#
# OJO con docker-start.sh: hace `migrate:fresh --seed` (borra datos).
# En Vercel NUNCA se ejecuta: las migraciones se corren aparte con
# `php artisan migrate --force`.

FROM dunglas/frankenphp:1-php8.2 AS base
WORKDIR /app

# php.ini de producción (OPcache activado, display_errors desactivado)
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

# Extensiones PHP:
#   pdo_pgsql -> Neon (Postgres serverless)
#   intl, zip -> Laravel
#   gd        -> dompdf / imagenes de PDF
#   bcmath    -> bacon-qr-code (carnets)
#   mbstring, dom, xml -> requisitos de laravel/framework
#   opcache   -> caché de bytecode en producción
RUN install-php-extensions pdo_pgsql intl zip gd bcmath mbstring dom xml opcache

# ── Etapa 1: dependencias de Composer (capa cachable) ───────────────────────
FROM base AS dependencies
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
RUN apt-get update \
    && apt-get install -y --no-install-recommends unzip \
    && rm -rf /var/lib/apt/lists/*
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --no-scripts --optimize-autoloader

# ── Etapa 2: imagen final ───────────────────────────────────────────────────
FROM base AS runtime

# Código de la aplicación. .dockerignore excluye .env, vendor/, tests/, .git/…
COPY . .

# Dependencias ya resueltas en la etapa anterior
COPY --from=dependencies /app/vendor ./vendor

# Directorios que Laravel necesita en tiempo de ejecución
RUN mkdir -p \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/framework/testing \
        storage/logs \
        bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache

# ── Cachés de framework ─────────────────────────────────────────────────────
# NUNCA `config:cache` (congelaría las variables de entorno que Vercel
# inyecta en tiempo de ejecución) y NUNCA `migrate`.
#
# Limpieza crítica: buildah en Vercel NO aplica el .dockerignore del contexto,
# así que pueden entrar al image el .env local y bootstrap/cache/*.php
# (services.php/packages.php/routes-v7.php generados en Windows con los
# paquetes DEV). Eso hacía fallar el arranque con:
#   Class "NunoMaduro\Collision\Adapters\Laravel\CollisionServiceProvider" not found
# Borramos todo para que Laravel lo regenere desde installed.json
# (solo paquetes de producción) y nos quedamos con el .env del entorno.
RUN rm -f bootstrap/cache/*.php .env

# Diagnóstico: php.ini-production trae display_errors=Off, que ocultaba el
# motivo del fallo. Se activa solo durante este paso y se quita después.
# Si un comando falla se imprime el código y se continúa: Laravel regenera
# estas cachés en tiempo de ejecución, así el despliegue no se bloquea.
#
# OJO: aquí NO se ejecuta `route:cache`. Las rutas con closures se guardan
# firmadas con APP_KEY, y la clave real solo existe en tiempo de ejecución
# (Vercel). Cachearla en el build la firmaba con una clave vacía y todas las
# peticiones reventaban con InvalidSignatureException. Se genera al arrancar
# (ver CMD abajo), cuando APP_KEY ya está disponible.
RUN printf 'display_errors=On\ndisplay_startup_errors=On\nlog_errors=On\nerror_reporting=-1\n' \
        > "$PHP_INI_DIR/conf.d/zz-build-debug.ini" \
    && echo "=== php -v ===" && php -v \
    && echo "=== php -m ===" && php -m \
    && for c in package:discover event:cache view:cache; do \
         echo "===== php artisan $c ====="; \
         php artisan "$c"; \
         echo "----- $c -> exit=$? -----"; \
       done \
    && rm -f "$PHP_INI_DIR/conf.d/zz-build-debug.ini" \
    && echo "=== fin de la fase de cachés ==="

# Valores por defecto de producción. Vercel los sobrescribe con los que
# declares en Settings > Environment Variables (o `vercel env add`).
ENV APP_ENV=production \
    APP_DEBUG=false \
    APP_KEY= \
    APP_URL= \
    LOG_CHANNEL=stderr \
    LOG_LEVEL=error \
    SESSION_DRIVER=database \
    CACHE_STORE=database \
    QUEUE_CONNECTION=sync \
    DB_CONNECTION=pgsql \
    DB_QUERY_LOG=false \
    APP_MAINTENANCE_DRIVER=database

COPY Caddyfile /etc/caddy/Caddyfile

# Vercel enruta al puerto 80 por defecto (se puede cambiar con PORT)
ENV PORT=80
EXPOSE 80

# Arranque: genera el caché de rutas con la APP_KEY real del entorno (las
# closures de las rutas se firman con ella) y luego levanta FrankenPHP.
# Si route:cache falla se sigue igual: Laravel usaría las rutas sin caché.
CMD ["sh", "-c", "php artisan route:cache || echo 'route:cache omitido'; exec frankenphp run --config /etc/caddy/Caddyfile"]
